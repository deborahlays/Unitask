# Configuração do Supabase (Opcional)
# Caso não configure estas chaves, o UniTask executará perfeitamente no Modo Local (LocalStorage)
# ou Modo Demonstração com todos os recursos habilitados para apresentação!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
